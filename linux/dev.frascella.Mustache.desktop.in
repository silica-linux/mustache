[Desktop Entry]
Type=Application
Name=Mustache
GenericName=File Manager
GenericName[it]=Gestore dei file
Comment=Folders and files
Comment[it]=Cartelle e file
Exec=@EMBEDDER@ --size 1000x700 --title Mustache --app-id dev.frascella.Mustache --multi-window @BUNDLE@
Icon=system-file-manager
X-Silica-Icon=mustache
StartupWMClass=dev.frascella.Mustache
Categories=System;FileManager;Utility;
Keywords=file;folder;documents;
Keywords[it]=file;cartelle;documenti;
Terminal=false
OnlyShowIn=Silica;
