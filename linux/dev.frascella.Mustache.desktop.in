[Desktop Entry]
Type=Application
Name=Mustache
GenericName=Gestore dei file
Comment=Cartelle e file
Exec=@EMBEDDER@ --size 1000x700 --title Mustache --app-id dev.frascella.Mustache @BUNDLE@
Icon=system-file-manager
X-Silica-Icon=mustache
StartupWMClass=dev.frascella.Mustache
Categories=System;FileManager;Utility;
Keywords=file;cartelle;documenti;
Terminal=false
OnlyShowIn=Silica;
